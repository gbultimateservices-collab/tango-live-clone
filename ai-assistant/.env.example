# ============================================
# JEEVA AI Assistant - Environment Variables
# ============================================

# Server
PORT=6000
NODE_ENV=development

# Database (MongoDB - optional, works with local JSON too)
MONGODB_URI=mongodb://localhost:27017/jeeva-ai

# Owner Security
OWNER_PIN=1234
JWT_SECRET=jeeva_super_secret_key_change_this

# AI Settings
AI_NAME=JEEVA
AI_LANGUAGE=hinglish
RESPONSE_STYLE=friendly

# Local Storage Path (mobile storage root)
LOCAL_STORAGE_PATH=./storage

# Device Communication
DEVICE_TIMEOUT_MS=5000
MAX_DEVICES=10
